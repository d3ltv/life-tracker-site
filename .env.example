# Copie ce fichier vers .env et remplis les valeurs.
# Ne commite jamais .env.

# Obligatoire en local pour que repas, journal, conseils et Business OS
# écrivent dans la même base que la prod.
SUPABASE_URL=https://TON-PROJET.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel. URL publique du site, utile pour CORS.
PUBLIC_ORIGIN=http://localhost:8766

# Optionnel. Doit faire au moins 24 caractères si tu testes la sync Mac.
INTEGRATION_SYNC_SECRET=

# Optionnel. LifeOS (saisie du matin).
LIFEOS_IA_URL=https://habit-track-xi.vercel.app/api/ia?scope=tout

# Optionnel. Seulement pour le fallback webhook, pas pour Hermes Gateway.
TELEGRAM_BOT_TOKEN=
